<Project Sdk="Microsoft.NET.Sdk">

  <!-- ci-smoke — compiles the package's Runtime sources (vendored core +
       Unity wrapper) plus the Demo sample's driver against the UnityEngine stubs in this
       folder, with plain dotnet. Catches API drift/typos in the only
       Unity-specific code without a Unity install or license. CI~/ is
       hidden from Unity itself (~ suffix). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- C# 9 = the vendored core's ceiling (Unity compiler parity) -->
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="UnityEngineStubs.cs" />
    <Compile Include="../Runtime/Core/**/*.cs" />
    <Compile Include="../Runtime/TelemetryPublisherBehaviour.cs" />
    <Compile Include="../Samples~/Demo/DemoVehicleDriver.cs" />
    <!-- EditMode tests use plain NUnit ([Test] only, no Unity coroutines),
         so they compile here too — the whole C# surface is smoke-checked -->
    <Compile Include="../Tests/Editor/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
  </ItemGroup>

</Project>
